diff --git a/test/const_alias_rescue_own.rb b/test/const_alias_rescue_own.rb
new file mode 100644
index 00000000..0d71f7c7
--- /dev/null
+++ b/test/const_alias_rescue_own.rb
@@ -0,0 +1,15 @@
+# A class that answers === itself is asked at the rescue: a constant holding
+# it is not read as the class's name there.
+class Quiet < StandardError
+  def self.===(e) = false
+end
+Q = Quiet
+begin
+  begin
+    raise Quiet, "q"
+  rescue Q
+    puts "wrong arm"
+  end
+rescue StandardError => e
+  puts "outer #{e.class}"
+end
