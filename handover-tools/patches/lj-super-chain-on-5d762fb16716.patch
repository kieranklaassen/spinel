 test/include_module_super_chain.rb            |  62 ++++++
 test/include_module_super_chain.rb.expected   |   7 +
 test/include_module_super_chain_held.rb       |  20 ++
 ...nclude_module_super_chain_held.rb.expected |   2 +
 5 files changed, 270 insertions(+)
 create mode 100644 test/include_module_super_chain.rb
 create mode 100644 test/include_module_super_chain.rb.expected
 create mode 100644 test/include_module_super_chain_held.rb
